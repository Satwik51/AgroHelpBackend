# AgroHelp Backend Environment Variables Template
# Copy this file to .env and customize values for production deployment

# Application Port
PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agrohelp_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# For Docker Compose:
# POSTGRES_DB=agrohelp_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password_here
